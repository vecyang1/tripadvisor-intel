# ==============================================================================
# tripadvisor-intel Environment Configuration Template
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
# ==============================================================================

# 1. SerpAPI Key (Required for anti-bot bypass & live TripAdvisor extraction)
# Obtain from https://serpapi.com
SERPAPI_API_KEY=

# 2. Google Gemini API Key (Optional: for qualitative LLM synthesis in travel dossiers)
# Obtain from https://aistudio.google.com
GOOGLE_API_KEY=

# 3. VectorEngine API Key (Optional: alternative OpenAI-compatible or Gemini proxy)
VECTORENGINE_API_KEY=

# 4. Cache Settings (Optional)
TRIPADVISOR_CACHE_ENABLED=true
TRIPADVISOR_CACHE_TTL_HOURS=48
# TRIPADVISOR_DATA_DIR=/custom/cache/path
